{
  "name": "simple-snake-game",
  "version": "1.5.0",
  "description": "Classic Snake game as a lightweight, offline, Manifest V3 Chrome extension.",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "node scripts/validate.js",
    "check": "npm run lint && npm run format:check && npm run validate && npm run coverage && npm run build",
    "build": "node scripts/build.js",
    "package": "npm run build",
    "release": "npm run check"
  },
  "keywords": [
    "snake",
    "game",
    "chrome-extension",
    "manifest-v3",
    "canvas",
    "javascript"
  ],
  "author": "Zhihua Lai (DoctorLai / justyy) <dr.zhihua.lai@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/doctorlai/snakegame#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/doctorlai/snakegame.git"
  },
  "bugs": {
    "url": "https://github.com/doctorlai/snakegame/issues"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "archiver": "^8.0.0",
    "eslint": "^10.8.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "vitest": "^3.2.4"
  }
}
